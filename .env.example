# Backend Parse Server (Back4App ou self-hosted)
VITE_PARSE_API_URL=https://parseapi.back4app.com
VITE_PARSE_APPLICATION_ID=
VITE_PARSE_REST_API_KEY=
VITE_PARSE_JAVASCRIPT_KEY=

# Cloudinary — upload des images et documents depuis l'admin.
# Sans préfixe VITE_ à dessein : la variable contient l'api_secret et n'est lue
# qu'au build (vite.config.ts), qui n'injecte que le nom du cloud dans le
# bundle. Accepte le nom de cloud nu ou la forme complète
# `cloudinary://<api_key>:<api_secret>@<cloud_name>`.
CLOUDINARY_URL=
# Upload preset en mode « Unsigned » (console Cloudinary → Settings → Upload).
VITE_CLOUDINARY_UPLOAD_PRESET=

# Google Analytics (optionnel, laisser vide pour désactiver)
VITE_GA_MEASUREMENT_ID=
